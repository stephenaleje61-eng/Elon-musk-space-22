rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwnerAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Ping / Test check
    match /test/{testId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isOwnerAdmin();
    }

    // 1. Friend Requests System (Real like Facebook)
    match /friendRequests/{reqId} {
      allow create: if true;
      allow read, update: if request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
        request.auth.uid == resource.data.senderId
      );
      allow delete: if isOwnerAdmin();
    }

    // Friendships Collection
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
        request.auth.uid in resource.data.participants
      );
      allow create, update, delete: if isOwnerAdmin();
    }

    // 2. Real Human 1-on-1 Conversations
    match /conversations/{convoId} {
      allow read: if request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isOwnerAdmin();
      allow update: if request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com';

      // Messages Subcollection
      match /messages/{msgId} {
        allow read, create: if request.auth != null && (
          (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
        );
        allow update: if request.auth != null && (
          (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
        );
        allow delete: if request.auth != null && request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com';
      }
    }

    // Catalogue Items (Nine Sections)
    match /items/{itemId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // User Saved Items
    match /saved_items/{savedItemId} {
      allow read, write: if true;
    }

    // User Financial Watchlists
    match /watchlists/{watchlistId} {
      allow read, write: if true;
    }

    // Users Directory
    match /users/{userId} {
      allow read, write: if true;
      allow delete: if isOwnerAdmin();
    }

    // Abusive Message Reports
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isOwnerAdmin();
    }

    // Legacy Support Collections
    match /joinRequests/{requestId} {
      allow read, write: if true;
    }

    match /privateChats/{visitorId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
