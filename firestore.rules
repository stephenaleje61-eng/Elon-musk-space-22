rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isOwnerAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'elonmuskspace241@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Ping check
    match /test/{testId} {
      allow read, write: if true;
    }

    // Admins collection - strictly restricted to owner
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isOwnerAdmin();
    }

    // Registered Chat Users directory
    match /users/{userId} {
      allow read, write: if true;
      allow delete: if isOwnerAdmin();
    }

    // Direct 1-on-1 Real Human Conversations
    match /conversations/{conversationId} {
      allow read, write: if true;
      allow delete: if isOwnerAdmin();

      // Messages Subcollection
      match /messages/{messageId} {
        allow read, write: if true;
        allow delete: if isOwnerAdmin();
      }
    }

    // Abusive Message & User Reports Queue - Only owner can read, resolve, delete
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isOwnerAdmin();
    }

    // Catalogue Items (Nine Sections)
    match /items/{itemId} {
      allow read: if true;
      allow write: if isOwnerAdmin();
    }

    // User Saved Items / Bookmarks
    match /saved_items/{savedItemId} {
      allow read, write: if true;
    }

    // User Financial Watchlists
    match /watchlists/{watchlistId} {
      allow read, write: if true;
    }

    // Legacy Support Collections
    match /joinRequests/{requestId} {
      allow read, write: if true;
    }

    match /privateChats/{visitorId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}
