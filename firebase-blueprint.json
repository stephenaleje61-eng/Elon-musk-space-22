{
  "entities": {
    "ChatUser": {
      "title": "ChatUser",
      "description": "Public profile and presence of a registered chat participant",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "online": { "type": "string" },
        "lastSeen": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "isSuspended": { "type": "string" }
      },
      "required": ["userId", "displayName"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct 1-on-1 human communication channel between two registered users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participants": { "type": "string", "maxLength": 512 },
        "lastMessage": { "type": "string", "maxLength": 4000 },
        "lastMessageAt": { "type": "string", "maxLength": 64 },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Permanent human-typed chat message saved in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 4000 },
        "imageUrl": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] }
      },
      "required": ["conversationId", "senderId", "receiverId", "text", "createdAt"]
    },
    "ChatReport": {
      "title": "ChatReport",
      "description": "User flagged abusive message or account report for owner moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reportedBy": { "type": "string", "maxLength": 128 },
        "reportedByName": { "type": "string", "maxLength": 128 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "messageId": { "type": "string", "maxLength": 128 },
        "messageText": { "type": "string", "maxLength": 4000 },
        "reason": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] }
      },
      "required": ["reportedBy", "reportedUserId", "messageId", "messageText", "reason"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Visitor-submitted friend request to chat with Elon Musk",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 128 },
        "senderEmail": { "type": "string", "maxLength": 256 },
        "receiverEmail": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "message": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["senderId", "senderName", "receiverEmail", "status"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Confirmed friendship between admin and visitor",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participants": { "type": "string" },
        "adminEmail": { "type": "string", "maxLength": 256 },
        "visitorId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["friends"] },
        "createdAt": { "type": "string" }
      },
      "required": ["participants", "adminEmail", "visitorId", "status"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin authorization entry",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "ContentItem": {
      "title": "ContentItem",
      "description": "Catalogue item, vehicle, technology project or article across nine sections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sectionId": {
          "type": "string",
          "enum": [
            "tesla-clean-energy",
            "robots-robotics",
            "space-rockets",
            "starlink-internet",
            "artificial-intelligence",
            "neuralink-brain-tech",
            "tunnel-transport",
            "x-digital-comm",
            "investment-finance"
          ]
        },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 5000 },
        "specifications": { "type": "string", "maxLength": 5000 },
        "price": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "maxLength": 16 },
        "images": { "type": "string", "maxLength": 5000 },
        "sourceUrl": { "type": "string", "maxLength": 1024 },
        "officialUrl": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["published", "draft", "announced", "prototype", "commercial"] },
        "isPublished": { "type": "string" },
        "isFeatured": { "type": "string" },
        "authorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["sectionId", "title", "description", "category"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "A bookmarked product, vehicle, or tech article saved by an authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "itemId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "sectionId": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 128 },
        "imageUrl": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "itemId", "title"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "An investment or stock tracker item on user's personal watchlist",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "ticker": { "type": "string", "maxLength": 32 },
        "companyName": { "type": "string", "maxLength": 128 },
        "targetPrice": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "ticker", "companyName"]
    }
  },
  "firestore": {
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "FriendRequest" },
      "description": "Visitor friend requests awaiting admin decision"
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "Friendship" },
      "description": "Accepted friendships between visitor and Elon Musk"
    },
    "/users/{userId}": {
      "schema": { "$ref": "ChatUser" },
      "description": "Registered chat participants with presence and display profile"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "Conversation" },
      "description": "Active real-time human chat channels between two registered users"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "ChatMessage" },
      "description": "Permanent human messages with real-time delivery and read status"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "ChatReport" },
      "description": "Flagged abusive messages and moderation queue for the owner"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "AdminRecord" },
      "description": "Admin identity records used for server-validated RBAC"
    },
    "/items/{itemId}": {
      "schema": { "$ref": "ContentItem" },
      "description": "Published content, products, vehicles, and innovation articles"
    },
    "/saved_items/{savedItemId}": {
      "schema": { "$ref": "SavedItem" },
      "description": "User bookmarked catalogue items"
    },
    "/watchlists/{watchlistId}": {
      "schema": { "$ref": "WatchlistItem" },
      "description": "User personal financial watchlist"
    }
  }
}
